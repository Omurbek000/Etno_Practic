# Адрес Django-бэкенда (etno/movie проект).
# Если бэкенд запущен локально стандартной командой `python manage.py runserver`,
# оставь как есть.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Языковой префикс, который добавляет i18n_patterns в movie/urls.py.
# В settings.py стоит LANGUAGE_CODE = 'ru-ru', поэтому по умолчанию "ru".
VITE_API_LANG=ru
